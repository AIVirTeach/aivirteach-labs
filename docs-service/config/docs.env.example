AIVIRTEACH_DOCS_HOST="127.0.0.1"
AIVIRTEACH_DOCS_PORT="8780"
AIVIRTEACH_DOCS_FETCH_TIMEOUT="3"

# Internal addresses used by Docs Service to fetch schemas on the Labs host.
AIVIRTEACH_VM_OPENAPI_URL="http://127.0.0.1:8760/openapi.json"
AIVIRTEACH_DIAGNOSTIC_OPENAPI_URL="http://127.0.0.1:8765/openapi.json"
AIVIRTEACH_AGENT_OPENAPI_URL="http://127.0.0.1:8770/openapi.json"

# Browser-visible addresses used by Swagger "Try it out" requests. Change
# these to SSH-forwarded or reverse-proxy URLs for a remote browser.
AIVIRTEACH_VM_DOCS_URL="http://127.0.0.1:8760"
AIVIRTEACH_DIAGNOSTIC_DOCS_URL="http://127.0.0.1:8765"
AIVIRTEACH_AGENT_DOCS_URL="http://127.0.0.1:8770"
