[Unit]
Description=AIVirTeach Labs VM management API
After=network-online.target libvirtd.service
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/aivirteach-labs
EnvironmentFile=/etc/aivirteach-labs.env
ExecStart=/opt/aivirteach-labs/start_service.sh
Restart=on-failure
RestartSec=3
PrivateTmp=true
ProtectHome=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
