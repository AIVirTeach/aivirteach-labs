# Generate a strong token, for example: openssl rand -hex 32
AIVIRTEACH_API_TOKEN="replace-with-a-long-random-token"

# Keep this token separate from the admin token. Only aivirteach-server uses it
# to request short-lived browser RDP sessions.
AIVIRTEACH_SESSION_TOKEN="replace-with-another-long-random-token"

# Same 16-byte (32 hex character) key configured for Guacamole JSON auth.
AIVIRTEACH_GUACAMOLE_JSON_SECRET="replace-with-openssl-rand-hex-16"
AIVIRTEACH_RDP_ALLOWED_CIDRS="192.168.122.0/24"
AIVIRTEACH_BROWSER_SESSION_TTL="60"

# Browser-visible service addresses shown by the unified Swagger document.
# Change these when the browser reaches the services through another host/tunnel.
AIVIRTEACH_DIAGNOSTIC_DOCS_URL="http://127.0.0.1:8765"
AIVIRTEACH_AGENT_DOCS_URL="http://127.0.0.1:8770"

# Keep loopback binding when using a local reverse proxy or SSH tunnel.
AIVIRTEACH_API_HOST="127.0.0.1"
AIVIRTEACH_API_PORT="8760"

# Defaults to ./libvirt. Set this only when scripts live elsewhere.
AIVIRTEACH_LIBVIRT_DIR="/opt/aivirteach-labs/libvirt"
AIVIRTEACH_COMMAND_TIMEOUT="30"
AIVIRTEACH_CREATE_TIMEOUT="180"
