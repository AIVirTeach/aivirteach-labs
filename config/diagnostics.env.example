# Used only by the standalone read-only Diagnostic Gateway.
AIVIRTEACH_DIAGNOSTIC_TOKEN="replace-with-a-long-random-read-only-token"
AIVIRTEACH_DIAGNOSTIC_HOST="127.0.0.1"
AIVIRTEACH_DIAGNOSTIC_PORT="8765"

# Allows the Swagger page on 8760 to call 8765 directly from the browser.
AIVIRTEACH_DIAGNOSTIC_CORS_ORIGINS="http://127.0.0.1:8760,http://localhost:8760"

# Comma-separated absolute paths inside learner VMs. A server-provided
# diagnostic_scope.workspace_root must stay below one of these roots.
AIVIRTEACH_GUEST_ALLOWED_ROOTS="/home/learner/course"

AIVIRTEACH_DIAGNOSTIC_COMMAND_TIMEOUT="8"
AIVIRTEACH_DIAGNOSTIC_MAX_OUTPUT_BYTES="65536"
