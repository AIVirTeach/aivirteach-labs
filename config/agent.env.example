# aivirteach-server -> Agent (8770). Do not reuse the VM administration token.
AIVIRTEACH_AGENT_TOKEN="replace-with-a-long-random-token"
AIVIRTEACH_AGENT_HOST="127.0.0.1"
AIVIRTEACH_AGENT_PORT="8770"

# Allows the Swagger page on 8760 to call the Agent directly from the browser.
AIVIRTEACH_AGENT_CORS_ORIGINS="http://127.0.0.1:8760,http://localhost:8760"

# Agent -> read-only Diagnostic Gateway (8765). The same token is configured on
# that gateway, but AIVIRTEACH_API_TOKEN must never be present in the Agent unit.
AIVIRTEACH_GATEWAY_URL="http://127.0.0.1:8765"
AIVIRTEACH_DIAGNOSTIC_TOKEN="replace-with-a-different-long-random-token"

# fake is useful for API smoke tests. openai_compatible enables actual reasoning.
AIVIRTEACH_MODEL_PROVIDER="fake"
AIVIRTEACH_MODEL_BASE_URL="https://provider.example/v1"
AIVIRTEACH_MODEL_API_KEY="replace-me"
AIVIRTEACH_MODEL_NAME="replace-me"

AIVIRTEACH_AGENT_TOTAL_TIMEOUT="40"
AIVIRTEACH_MODEL_TIMEOUT="15"
AIVIRTEACH_TOOL_TIMEOUT="8"
AIVIRTEACH_MAX_REASONING_TURNS="4"
AIVIRTEACH_MAX_TOOL_CALLS="6"
AIVIRTEACH_MAX_TOOL_OUTPUT_CHARS="32768"
AIVIRTEACH_MAX_CONCURRENT_REQUESTS="4"
